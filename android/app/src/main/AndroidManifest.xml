<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Foreground download notification (Android 13+). FOREGROUND_SERVICE,
         FOREGROUND_SERVICE_DATA_SYNC and the dataSync service type come from
         workmanager_android's opt-in manifest, enabled by
         workmanager.enableDataSyncForegroundService=true in gradle.properties. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Yomi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher_sumi"
        android:roundIcon="@mipmap/ic_launcher_sumi"
        android:largeHeap="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>

        <!-- Launcher entry points, one per look (LookActivities.kt). Each
             carries its own launcher icon and launch theme (splash colour +
             icon), which an activity-alias cannot. Exactly one is enabled at
             a time; MainActivity.setLauncherAlias flips them when the user
             changes the look. Sumi is the manifest default (matches the
             theme.look pref default). Home-screen widgets still target the
             base .MainActivity, which has no launcher filter. -->
        <activity
            android:name=".MainActivitySumi"
            android:enabled="true"
            android:exported="true"
            android:label="Yomi"
            android:icon="@mipmap/ic_launcher_sumi"
            android:roundIcon="@mipmap/ic_launcher_sumi"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme.Sumi"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme.Sumi"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivityCinema"
            android:enabled="false"
            android:exported="true"
            android:label="Yomi"
            android:icon="@mipmap/ic_launcher_cinema"
            android:roundIcon="@mipmap/ic_launcher_cinema"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme.Cinema"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme.Cinema"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivityPastel"
            android:enabled="false"
            android:exported="true"
            android:label="Yomi"
            android:icon="@mipmap/ic_launcher_pastel"
            android:roundIcon="@mipmap/ic_launcher_pastel"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme.Pastel"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme.Pastel"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- FileProvider for sharing the downloaded APK with the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- App Widget Provider: Recently Updated -->
        <receiver
            android:name=".LibraryWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/library_widget_info" />
        </receiver>
        
        <!-- App Widget Provider: Continue Reading -->
        <receiver
            android:name=".ContinueReadingWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_reading_widget_info" />
        </receiver>

        <!-- RemoteViews Service for the Widget List -->
        <service
            android:name=".LibraryWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
            
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
