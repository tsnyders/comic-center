<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_cr_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background_shape" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_shape_round" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <FrameLayout android:layout_width="80dp" android:layout_height="116dp">
            <ImageView android:id="@+id/widget_cr_cover_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_cover_round" />
            <ImageView android:id="@+id/widget_cr_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Comic cover" android:scaleType="centerCrop" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="14dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_cr_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/quicksand" android:text="Continue" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_cr_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:fontFamily="@font/gaegu_bold" android:maxLines="2" android:textSize="20sp" />
            <TextView android:id="@+id/widget_cr_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/quicksand" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_cr_progress_rule" android:layout_width="18dp" android:layout_height="2dp" />
                <TextView android:id="@+id/widget_cr_progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/quicksand" android:maxLines="1" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <FrameLayout android:id="@+id/widget_cr_button_container" android:layout_width="74dp" android:layout_height="30dp" android:layout_marginTop="7dp">
                <ImageView android:id="@+id/widget_cr_button_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill" />
                <TextView android:id="@+id/widget_cr_button" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="@font/quicksand" android:gravity="center" android:text="Open" android:textSize="11sp" android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
