<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_cr_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background_shape" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_shape_square" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <FrameLayout android:layout_width="80dp" android:layout_height="116dp">
            <ImageView android:id="@+id/widget_cr_cover_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_cover_square" />
            <ImageView android:id="@+id/widget_cr_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Comic cover" android:scaleType="centerCrop" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="14dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_cr_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/barlow_regular" android:letterSpacing="0.25" android:text="CONTINUE READING" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_cr_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:fontFamily="@font/barlow_condensed_extra_bold" android:letterSpacing="0.04" android:maxLines="2" android:textSize="18sp" />
            <TextView android:id="@+id/widget_cr_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/barlow_regular" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/widget_cr_progress_rule" android:layout_width="18dp" android:layout_height="2dp" />
                <TextView android:id="@+id/widget_cr_progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/barlow_regular" android:maxLines="1" android:textSize="9sp" />
            </LinearLayout>
            <FrameLayout android:id="@+id/widget_cr_button_container" android:layout_width="70dp" android:layout_height="28dp" android:layout_marginTop="7dp">
                <ImageView android:id="@+id/widget_cr_button_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_cover_square" />
                <TextView android:id="@+id/widget_cr_button" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="@font/barlow_condensed_extra_bold" android:gravity="center" android:letterSpacing="0.08" android:text="OPEN" android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_border_top" android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="top" />
    <ImageView android:id="@+id/widget_border_bottom" android:layout_width="match_parent" android:layout_height="1dp" android:layout_gravity="bottom" />
    <ImageView android:id="@+id/widget_border_start" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="start" />
    <ImageView android:id="@+id/widget_border_end" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="end" />
</FrameLayout>
